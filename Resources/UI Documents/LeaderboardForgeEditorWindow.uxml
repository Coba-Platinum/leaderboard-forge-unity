<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/com.cobaplatinum.leaderboardforge/Resources/Style/LeaderboardForgeEditorStyles.uss?fileID=7433441132597879392&amp;guid=5382101a041713b45937c3df08b67566&amp;type=3#LeaderboardForgeEditorStyles" />
    <ui:VisualElement name="TitleBar" style="flex-grow: 0; height: 25px; color: rgb(0, 168, 255); background-color: rgb(0, 168, 255); justify-content: space-around; align-items: center; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; margin-top: 5px; margin-right: 5px; margin-bottom: 0; margin-left: 5px;">
        <ui:Label text="Coba Platinum Leaderboard Forge" name="Title" style="-unity-text-align: middle-center; color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 14px;" />
    </ui:VisualElement>
    <ui:VisualElement name="PlatformConnectionPanel" style="flex-grow: 0; width: auto; height: auto; left: auto; margin-left: 5px; margin-bottom: 5px; margin-right: 5px; justify-content: space-between; flex-shrink: 0; right: auto;">
        <ui:Label text="🌐 Platform Connection" name="PlatformConnectionLabel" style="background-color: rgb(20, 20, 20); color: rgb(255, 255, 255); -unity-font-style: bold; padding-bottom: 0; padding-top: 6px; padding-left: 6px; margin-bottom: 0; margin-left: 0; padding-right: 6px; margin-right: 0; margin-top: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; border-top-right-radius: 5px; border-top-left-radius: 5px; height: 27px;" />
        <ui:VisualElement name="ConnectionInfoPanel" style="flex-grow: 0; background-color: rgb(36, 36, 36); flex-shrink: 0; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; border-top-right-radius: 5px; border-top-left-radius: 5px; opacity: 1; display: flex; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; margin-top: 5px;">
            <ui:TextField label="API Base URL" placeholder-text="https://leaderboards.cobaplatinum.com" name="APIURLInput" style="border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); color: rgb(255, 255, 255); -unity-text-align: middle-left; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; -unity-background-image-tint-color: rgb(255, 255, 255); -unity-text-outline-width: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 12px;" />
            <ui:TextField label="API Key" name="APIKeyInput" password="true" style="border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); color: rgb(255, 255, 255); -unity-text-align: middle-left; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; -unity-background-image-tint-color: rgb(255, 255, 255); -unity-text-outline-width: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 12px;" />
            <ui:Button text="Test Connection" name="TestConnectionButton" style="height: 30px; margin-top: 10px;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="ProvisionNewLeaderboardPanel" style="flex-grow: 0; width: auto; height: auto; left: auto; margin-left: 5px; margin-bottom: 5px; margin-right: 5px; justify-content: space-between; flex-shrink: 0; right: auto;">
        <ui:Label text="🛠️ Provision New Leaderboard" name="ProvisionLabel" style="background-color: rgb(20, 20, 20); color: rgb(255, 255, 255); -unity-font-style: bold; padding-bottom: 0; padding-top: 6px; padding-left: 6px; margin-bottom: 0; margin-left: 0; padding-right: 6px; margin-right: 0; margin-top: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; border-top-right-radius: 5px; border-top-left-radius: 5px; height: 27px;" />
        <ui:VisualElement name="ProvisionPanel" style="flex-grow: 0; background-color: rgb(36, 36, 36); flex-shrink: 0; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; border-top-right-radius: 5px; border-top-left-radius: 5px; opacity: 1; display: flex; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; margin-top: 5px;">
            <ui:TextField label="Leaderboard Name" placeholder-text="Click-BOOM! Highscores" name="NewLeaderboardNameInput" style="border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); color: rgb(255, 255, 255); -unity-text-align: middle-left; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; -unity-background-image-tint-color: rgb(255, 255, 255); -unity-text-outline-width: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 12px;" />
            <ui:Toggle label="Ascending Order?" name="AscendingOrderToggle" style="border-top-width: 5px; margin-bottom: 10px; margin-top: 3px;" />
            <ui:DropdownField label="User ID Mode&#10;" choices="Unique ID,Username Only" index="0" name="UserIDModeDropdown" style="-unity-text-align: middle-left; min-height: 30px;" />
            <ui:DropdownField label="Profanity Filter" choices="Censor,Block,None" index="0" name="ProfanityFilterDropdown" style="-unity-text-align: middle-left; min-height: 30px;" />
            <ui:Button text="Provision Leaderboard" name="ProvisionLeaderboardButton" style="height: 30px; margin-top: 10px;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="BakeConfigPanel" style="flex-grow: 0; width: auto; height: auto; left: auto; margin-left: 5px; margin-bottom: 5px; margin-right: 5px; justify-content: space-between; flex-shrink: 0; right: auto;">
        <ui:Label text="📦 Bake Config Asset" name="BakeConfigLabel" style="background-color: rgb(20, 20, 20); color: rgb(255, 255, 255); -unity-font-style: bold; padding-bottom: 0; padding-top: 6px; padding-left: 6px; margin-bottom: 0; margin-left: 0; padding-right: 6px; margin-right: 0; margin-top: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; border-top-right-radius: 5px; border-top-left-radius: 5px; height: 27px;" />
        <ui:VisualElement name="BakeConfigPanel" style="flex-grow: 0; background-color: rgb(36, 36, 36); flex-shrink: 0; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; border-top-right-radius: 5px; border-top-left-radius: 5px; opacity: 1; display: flex; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; margin-top: 5px;">
            <uie:ObjectField label="Target Config&#10;" name="ConfigAssetField" type="CobaPlatinum.LeaderboardForge.LeaderboardConfigDefinition, com.cobaplatinum.leaderboardforge.runtime" style="min-height: 20px; margin-bottom: 5px;" />
            <ui:DropdownField label="Leaderboard" choices="Add Manually" index="0" name="BakeConfigLeaderboardSelectDropdown" style="-unity-text-align: middle-left; min-height: 30px;" />
            <ui:TextField label="Public Key" name="PublicKeyInput" hide-placeholder-on-focus="true" password="false" style="border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); color: rgb(255, 255, 255); -unity-text-align: middle-left; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; -unity-background-image-tint-color: rgb(255, 255, 255); -unity-text-outline-width: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 12px;" />
            <ui:TextField label="Secret Key" name="SecretKeyInput" hide-placeholder-on-focus="true" password="true" style="border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); color: rgb(255, 255, 255); -unity-text-align: middle-left; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; -unity-background-image-tint-color: rgb(255, 255, 255); -unity-text-outline-width: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 12px;" />
            <ui:Button text="Bake into Config Asset" name="BakeConfigButton" style="height: 30px; margin-top: 10px;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="DiagnosticViewerPanel" style="flex-grow: 0; width: auto; height: auto; left: auto; margin-left: 5px; margin-bottom: 5px; margin-right: 5px; justify-content: space-between; flex-shrink: 0; right: auto;">
        <ui:Label text="📊 Live Diagnostic Viewer (READ-ONLY)" name="DiagnosticLabel" style="background-color: rgb(20, 20, 20); color: rgb(255, 255, 255); -unity-font-style: bold; padding-bottom: 0; padding-top: 6px; padding-left: 6px; margin-bottom: 0; margin-left: 0; padding-right: 6px; margin-right: 0; margin-top: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; border-top-right-radius: 5px; border-top-left-radius: 5px; height: 27px;" />
        <ui:VisualElement name="DiagnosticPanel" style="flex-grow: 0; background-color: rgb(36, 36, 36); flex-shrink: 0; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; border-top-right-radius: 5px; border-top-left-radius: 5px; opacity: 1; display: flex; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; margin-top: 5px;">
            <ui:DropdownField label="Leaderboard" choices="none" index="0" name="DiagnosticLeaderboardSelectDropdown" style="-unity-text-align: middle-left; min-height: 30px;" />
            <ui:Button text="Refresh Live Entries" name="RefreshEntriesButton" style="height: 30px; margin-top: 10px;" />
            <ui:VisualElement name="DiagnosticTableShell" style="margin-top: 10px; background-color: rgb(25, 25, 25); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px;">
                <ui:VisualElement name="TableHeaderRow" style="flex-direction: row; padding-left: 6px; padding-right: 6px; padding-top: 4px; padding-bottom: 4px; background-color: rgb(12, 12, 12); border-bottom-width: 1px; border-bottom-color: rgb(68, 68, 68); border-top-left-radius: 5px; border-top-right-radius: 5px;">
                    <ui:Label text="Rank" style="width: 45px; color: rgb(136, 136, 136); -unity-font-style: bold; font-size: 11px;" />
                    <ui:Label text="Username" style="flex-grow: 1; color: rgb(136, 136, 136); -unity-font-style: bold; font-size: 11px;" />
                    <ui:Label text="Score" style="width: 80px; color: rgb(136, 136, 136); -unity-font-style: bold; -unity-text-align: middle-right; font-size: 11px;" />
                </ui:VisualElement>
                <ui:ScrollView name="EntriesScrollView" mouse-wheel-scroll-size="5" style="max-height: 250px; min-height: 250px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;">
                    <ui:VisualElement enabled="true" style="flex-direction: row; padding-left: 6px; padding-right: 6px; padding-top: 4px; padding-bottom: 4px; border-bottom-width: 1px; border-bottom-color: rgb(38, 38, 38); min-height: 40px;">
                        <ui:Label text="No leaderboard entries loaded... Please refresh..." style="flex-grow: 1; color: rgb(255, 255, 255); font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; align-self: auto; align-content: auto;" />
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:Button text="Purge Leaderboard Entries" name="PurgeLeaderboardEntriesButton" style="height: 30px; margin-top: 10px; color: rgb(255, 255, 255); background-color: rgb(255, 88, 88);" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement style="flex-grow: 1; justify-content: flex-end; align-content: flex-end; margin-left: 5px; margin-right: 5px; margin-bottom: 5px;">
        <ui:VisualElement name="Footer" style="flex-grow: 1; height: 69px; background-color: rgb(25, 25, 25); transform-origin: center; min-height: 5px; max-height: 40px; -unity-text-outline-color: rgb(25, 25, 25); align-content: center; justify-content: center; padding-left: 10px; padding-right: 10px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;">
            <ui:Label text="Version 1.0.0 - Created by Coba Platinum" name="InfoLabel" style="font-size: 13px; -unity-font-style: bold;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
