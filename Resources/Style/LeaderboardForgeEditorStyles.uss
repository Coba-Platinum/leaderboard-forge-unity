VisualElement {
}

.unity-text-field__input {
    border-radius: 5px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0.39);
    border-color: rgba(255, 255, 255, 0.2);
    color: rgb(255, 255, 255);
    --unity-cursor-color: rgb(255, 255, 255);
    font-size: 14px;
    height: 30px;
    padding-left: 5px;
    padding-right: 5px;
}

.unity-text-field > .unity-label {
    color: rgb(200, 200, 200);
}

.unity-text-field:focus > .unity-label {
    color: rgb(200, 200, 200);
}

.unity-base-text-field__input--placeholder {
    color: rgb(132, 132, 132);
}

.unity-base-field__label {
    color: rgb(188, 188, 188);
    -unity-font-style: bold;
    font-size: 12px;
}

.unity-toggle__checkmark {
    border-radius: 5px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background-color: rgb(0, 0, 0);
    -unity-text-outline-color: rgb(0, 0, 0);
    font-size: 20px;
}

.unity-button {
    background-image: none;
    border-radius: 5px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    background-color: rgb(88, 88, 88);
    border-color: rgba(0, 0, 0, 0);
    transition-property: background-color, scale;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.unity-button:hover:enabled {
    background-image: none;
    background-color: rgb(110, 110, 110);
}

.unity-button:active:enabled {
    background-image: none;
    background-color: rgb(65, 65, 65);
}

.unity-popup-field .unity-popup-field__input {
    background-image: none;
    background-color: rgba(0, 0, 0, 0.39);
    border-radius: 5px;
    border-width: 0;
    color: rgb(255, 255, 255);
    padding-left: 8px;
    transition-property: background-color;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.unity-base-popup-field .unity-base-popup-field__input {
    background-image: none;
    background-color: rgba(0, 0, 0, 0.39);
    border-radius: 5px;
    border-width: 0;
    color: rgb(255, 255, 255);
    padding-left: 8px;
    transition-property: background-color;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.unity-popup-field .unity-popup-field__input:hover:enabled {
    background-color: rgb(110, 110, 110);
}

.unity-base-popup-field .unity-base-popup-field__input:hover:enabled {
    background-color: rgb(110, 110, 110);
}

.unity-popup-field__arrow {
    -unity-background-image-tint-color: rgb(200, 200, 200);
}

.unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(200, 200, 200);
}

.unity-base-dropdown__container {
    background-color: rgb(45, 45, 45);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    min-height: auto;
}

.unity-base-dropdown__item {
    color: rgb(255, 255, 255);
}

.unity-base-dropdown__item:hover {
    background-color: rgb(88, 88, 88);
}

.unity-scroller .unity-scroller__low-button {
    display: none;
}

.unity-scroller .unity-scroller__high-button {
    display: none;
}

.unity-scroller {
    width: 10px;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 0;
}

.unity-scroller .unity-slider__input {
    background-color: transparent;
    border-width: 0;
}

.unity-scroller .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

.unity-scroller .unity-base-slider__dragger {
    background-image: none;
    background-color: rgb(88, 88, 88);
    border-radius: 2px;
    border-width: 0;
    width: 70%;
    max-width: 8px;
    min-width: 6px;
    min-height: 30px;
    position: absolute;
    left: 0;
    right: 0;
    margin-left: auto;
    margin-right: auto;
    margin-top: 0;
    margin-bottom: 0;
    transition-property: background-color;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.unity-scroller .unity-scroller__slider {
    margin-top: 2px;
    margin-bottom: 2px;
    min-height: 10px;
}

.unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgb(110, 110, 110);
}

.unity-scroller .unity-base-slider__dragger:active {
    background-color: rgb(65, 65, 65);
}
